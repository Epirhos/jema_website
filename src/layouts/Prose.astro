---
/** Gabarit des pages de texte (légal, informations) : une feuille posée sur le bureau. */
import Base from './Base.astro'
import { url } from '../lib/url.js'

interface Props { title: string; description?: string; updated?: Date }
const { title, description, updated } = Astro.props
const fmt = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' })
---

<Base title={title} description={description}>
  <section class="prose-sec">
    <div class="wrap">
      <article class="sheet prose-jema doc">
        <a href={url('/')} class="back">← Retour à l'accueil</a>
        <h1>{title}</h1>
        <slot />
        {updated && <p class="upd">Dernière mise à jour : {fmt.format(updated)}</p>}
      </article>
    </div>
  </section>
</Base>

<style>
  .prose-sec { padding: calc(96px + env(safe-area-inset-top, 0px)) 0 72px; }
  .doc { max-width: 780px; margin: 0 auto; padding: clamp(24px, 5vw, 56px); }
  .back { display: inline-block; margin-bottom: 20px; font-size: 14px; font-weight: 600; color: var(--jema) !important; text-decoration: none !important; }
  .upd { margin-top: 40px; font-size: 12.5px; color: var(--mute); }
</style>
