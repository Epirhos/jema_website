---
import Base from '../layouts/Base.astro'
import { url } from '../lib/url.js'
---

<Base title="Page introuvable">
  <section class="nf">
    <div class="wrap">
      <div class="sheet card">
        <p class="folio">Folio 404</p>
        <h1 class="display">Cette page n'a pas été écrite… <em>pour l'instant.</em></h1>
        <p class="lead">Le lien est peut-être ancien, ou la page a changé de chapitre.</p>
        <a class="btn btn--ink" href={url('/')}>Retour à l'accueil</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding: calc(110px + env(safe-area-inset-top, 0px)) 0 90px; }
  .card { max-width: 680px; margin: 0 auto; padding: clamp(28px, 5vw, 56px); display: grid; gap: 16px; justify-items: start; }
  h1 { font-size: clamp(32px, 5vw, 48px); margin: 0; }
  .folio, .lead { margin: 0; }
</style>
