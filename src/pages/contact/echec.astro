---
/** Envoi du formulaire de contact refusé ou en panne, sans JavaScript (functions/contact.js). Non indexée. */
import Prose from '../../layouts/Prose.astro'
import site from '../../data/site.json'
import { url } from '../../lib/url.js'
---

<Prose title="Message non envoyé" description="Le message n'a pas pu être envoyé.">
  <p>Votre message n'a pas pu partir. Vérifiez votre adresse e-mail et la longueur du message (10 caractères au moins), puis <a href={url('/#contact')}>réessayez</a>.</p>
  <p>Vous pouvez aussi nous écrire directement à <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.</p>
</Prose>
