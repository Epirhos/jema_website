---
/** Bandeau d'annonce global, piloté par src/data/site.json (éditable depuis l'admin). */
import site from '../../data/site.json'
const { enabled, text, link, linkLabel } = site.banner
---

{
  enabled && text && (
    <div class="banner">
      <p class="wrap">
        <span>{text}</span>
        {link && <a href={link}>{linkLabel || 'En savoir plus'} →</a>}
      </p>
    </div>
  )
}

<style>
  .banner { background: var(--jema); color: #fff; padding-top: calc(64px + env(safe-area-inset-top, 0px)); }
  p { margin: 0; padding-top: 10px; padding-bottom: 10px; display: flex; flex-wrap: wrap; gap: 4px 12px; justify-content: center; font-size: 14px; }
  a { color: #fff; font-weight: 700; }
</style>
