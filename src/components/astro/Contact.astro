---
/** Contact (provisoire : ouvre le client mail). Un vrai formulaire arrivera avec l'étape « pages ». */
import site from '../../data/site.json'
---

<section id="contact" class="contact">
  <div class="wrap">
    <div class="sheet card" data-reveal>
      <div class="head">
        <span class="kicker">Contact</span>
        <h2 class="h2">Un retour, une question, un bug ?</h2>
        <p class="lead">Pendant la bêta, chaque message compte. Écrivez à <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.</p>
      </div>
      <form data-contact class="form">
        <label for="c-subject">Sujet</label>
        <input id="c-subject" name="subject" placeholder="Une idée, un bug, une suggestion…" />
        <label for="c-body">Message</label>
        <textarea id="c-body" name="body" rows="4" placeholder="Dites-nous tout…"></textarea>
        <button class="btn btn--ink" type="submit" data-umami-event="contact-envoyer">Écrire avec mon client mail</button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact { padding: clamp(56px, 8vw, 96px) 0; }
  .card { max-width: 820px; margin: 0 auto; padding: clamp(24px, 4vw, 40px); display: grid; gap: 22px; }
  .head { display: grid; gap: 10px; }
  .lead a { color: var(--jema); }
  .form { display: grid; gap: 8px; }
  label { font-size: 14px; font-weight: 600; }
  input, textarea { font: 16px var(--f-ui); color: var(--ink); background: var(--desk-2); border: 1px solid var(--rule); border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; }
  input:focus, textarea:focus { outline: 2px solid var(--jema); outline-offset: 1px; }
  .form .btn { justify-self: start; }
</style>

<script>
  import site from '../../data/site.json'
  document.querySelector<HTMLFormElement>('[data-contact]')?.addEventListener('submit', (e) => {
    e.preventDefault()
    const f = e.currentTarget as HTMLFormElement
    const s = encodeURIComponent((f.subject as unknown as HTMLInputElement).value || 'Retour sur Jema')
    const b = encodeURIComponent((f.body as unknown as HTMLTextAreaElement).value || '')
    window.location.href = `mailto:${site.contactEmail}?subject=${s}&body=${b}`
  })
</script>
