---
/**
 * Contact : formulaire envoyé à la fonction Cloudflare /contact (functions/contact.js),
 * qui le transmet par e-mail à l'éditeur. Fonctionne aussi sans JavaScript
 * (redirection vers /contact/merci ou /contact/echec).
 * Le champ « site_web » est un piège à robots, invisible pour les personnes ;
 * « t » note l'heure d'affichage (un envoi en moins de 3 s est ignoré).
 */
import site from '../../data/site.json'
import { url } from '../../lib/url.js'
---

<section id="contact" class="contact">
  <div class="wrap">
    <div class="sheet card" data-reveal>
      <div class="head">
        <span class="kicker">Contact</span>
        <h2 class="h2">Un retour, une question, un bug ?</h2>
        <p class="lead">Pendant la bêta, chaque message compte. Nous répondons à l'adresse que vous indiquez.</p>
      </div>
      <form data-contact class="form" method="post" action={url('/contact')} novalidate>
        <div class="row">
          <div class="field">
            <label for="c-nom">Nom <span class="opt">(facultatif)</span></label>
            <input id="c-nom" name="nom" autocomplete="name" maxlength="80" />
          </div>
          <div class="field">
            <label for="c-email">Votre e-mail</label>
            <input id="c-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="c-email-aide" />
            <span id="c-email-aide" class="aide">Seulement pour vous répondre.</span>
          </div>
        </div>
        <div class="field">
          <label for="c-sujet">Sujet</label>
          <select id="c-sujet" name="sujet">
            <option value="question">Une question</option>
            <option value="bug">Un bug</option>
            <option value="idee">Une idée</option>
            <option value="presse">Presse ou partenariat</option>
            <option value="autre">Autre</option>
          </select>
        </div>
        <div class="field">
          <label for="c-message">Message</label>
          <textarea id="c-message" name="message" rows="5" minlength="10" maxlength="5000" required placeholder="Dites-nous tout. Pour un bug : ce que vous faisiez, ce qui s'est passé, votre système."></textarea>
        </div>
        <div class="piege" aria-hidden="true">
          <label for="c-site">Ne pas remplir</label>
          <input id="c-site" name="site_web" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="t" value="" />
        <p class="rgpd">
          Votre message nous parvient par e-mail. Il n'est pas conservé sur le site et ne sert qu'à vous répondre.
          <a href={url('/legal/confidentialite#contact')}>Vos données</a>
        </p>
        <div class="actions">
          <button class="btn btn--ink" type="submit" data-umami-event="contact-envoyer">Envoyer</button>
          <p class="etat" role="status" aria-live="polite" data-etat></p>
        </div>
      </form>
      <p class="alt">Vous préférez votre messagerie ? <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
    </div>
  </div>
</section>

<style>
  .contact { padding: clamp(56px, 8vw, 96px) 0; }
  .card { max-width: 820px; margin: 0 auto; padding: clamp(24px, 4vw, 40px); display: grid; gap: 22px; }
  .head { display: grid; gap: 10px; }
  .form { display: grid; gap: 14px; }
  .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; align-items: start; }
  .field { display: grid; gap: 6px; }
  label { font-size: 14px; font-weight: 600; }
  .opt, .aide { font-weight: 400; font-size: 13px; color: var(--mute); }
  input, textarea, select { font: 16px var(--f-ui); color: var(--ink); background: var(--desk-2); border: 1px solid var(--rule); border-radius: 8px; padding: 10px 12px; width: 100%; }
  textarea { resize: vertical; min-height: 120px; }
  input:focus, textarea:focus, select:focus { outline: 2px solid var(--jema); outline-offset: 1px; }
  [aria-invalid='true'] { border-color: var(--danger); }
  .piege { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .rgpd { margin: 0; font-size: 13px; color: var(--mute); }
  .rgpd a, .alt a { color: var(--jema); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .actions .btn[disabled] { opacity: 0.6; cursor: wait; }
  .etat { margin: 0; font-size: 15px; }
  .etat.ok { color: var(--ok); }
  .etat.ko { color: var(--danger); }
  .alt { margin: 0; font-size: 14px; color: var(--mute); }
</style>

<script>
  import site from '../../data/site.json'

  const ERREURS: Record<string, string> = {
    email: 'Vérifiez votre adresse e-mail.',
    message: 'Votre message est un peu court (10 caractères au moins).',
    limite: 'Trop de messages en peu de temps. Réessayez dans une heure.',
    indisponible: `Le formulaire est momentanément indisponible. Écrivez-nous à ${site.contactEmail}.`,
    envoi: `L'envoi a échoué. Réessayez, ou écrivez-nous à ${site.contactEmail}.`
  }

  const form = document.querySelector<HTMLFormElement>('[data-contact]')
  if (form) {
    const t = form.querySelector<HTMLInputElement>('input[name="t"]')!
    const etat = form.querySelector<HTMLElement>('[data-etat]')!
    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!
    t.value = String(Date.now())

    const dire = (msg: string, ok: boolean) => {
      etat.textContent = msg
      etat.className = `etat ${ok ? 'ok' : 'ko'}`
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const email = form.elements.namedItem('email') as HTMLInputElement
      const message = form.elements.namedItem('message') as HTMLTextAreaElement
      email.setAttribute('aria-invalid', String(!email.validity.valid))
      message.setAttribute('aria-invalid', String(message.value.trim().length < 10))
      if (!email.validity.valid) { dire(ERREURS.email, false); email.focus(); return }
      if (message.value.trim().length < 10) { dire(ERREURS.message, false); message.focus(); return }

      bouton.disabled = true
      dire('Envoi…', true)
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form)
        })
        const r = await res.json().catch(() => ({ ok: false, erreur: 'envoi' }))
        if (r.ok) {
          form.reset()
          t.value = String(Date.now())
          dire('Merci, votre message est parti. Nous vous répondons dès que possible.', true)
        } else {
          dire(ERREURS[r.erreur] || ERREURS.envoi, false)
        }
      } catch {
        dire(ERREURS.envoi, false)
      } finally {
        bouton.disabled = false
      }
    })
  }
</script>
